# ── AI backend ──────────────────────────────────────────────────────────────
# Set GOOGLE_CLOUD_API_KEY for Vertex AI Express mode (easiest).
# Or set GOOGLE_CLOUD_PROJECT and use Application Default Credentials instead.
GOOGLE_CLOUD_API_KEY=

# Used by ADC mode and by Gemma MaaS models (which require ADC + project).
GOOGLE_CLOUD_PROJECT=

# Deepgram text-to-speech
DEEPGRAM_TTS_KEY=

# ── Model selection ──────────────────────────────────────────────────────────
OPEN_DESK_AI_MODEL=google/gemma-4-26b-a4b-it-maas

# Override the routing-only model (defaults to OPEN_DESK_AI_MODEL)
# OPEN_DESK_ROUTER_MODEL=google/gemma-4-26b-a4b-it-maas

# Gemini thinking level: LOW | MEDIUM | HIGH (default HIGH for Gemini 3)
# OPEN_DESK_THINKING_LEVEL=HIGH

# Thinking budget for models that support numeric budgets. Set 0 for fastest mode.
# OPEN_DESK_THINKING_BUDGET=1024

# ── TTS ──────────────────────────────────────────────────────────────────────
# OPEN_DESK_TTS_MODEL=aura-2-thalia-en

# ── STT / Whisper ────────────────────────────────────────────────────────────
# OPEN_DESK_STT_MODEL=tiny.en
# OPEN_DESK_STT_REALTIME_MODEL=tiny.en
# OPEN_DESK_STT_DEVICE=cpu
# OPEN_DESK_STT_LANGUAGE=en
# OPEN_DESK_STT_COMPUTE_TYPE=int8
# OPEN_DESK_STT_REALTIME_PAUSE=0.08
# OPEN_DESK_STT_SILENCE_DURATION=0.9
# OPEN_DESK_STT_LOAD_TIMEOUT=90
# OPEN_DESK_STT_PORT=38476

# Force a specific microphone (optional — auto-selected by default)
# OPEN_DESK_STT_INPUT_DEVICE_INDEX=
# OPEN_DESK_STT_INPUT_DEVICE_MATCH=

# ── Agent ────────────────────────────────────────────────────────────────────
# OPEN_DESK_MAX_AGENT_STEPS=12
# OPEN_DESK_SCREENSHOT_MAX_WIDTH=900
# OPEN_DESK_UTTERANCE_DEBOUNCE=1.4

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
# OPEN_DESK_AI_ROUTER_TIMEOUT=25
# OPEN_DESK_AI_ACTION_TIMEOUT=75
# OPEN_DESK_AI_CHECK_TIMEOUT=25
# OPEN_DESK_AI_FINAL_TIMEOUT=40
# OPEN_DESK_SCREENSHOT_TIMEOUT=8
