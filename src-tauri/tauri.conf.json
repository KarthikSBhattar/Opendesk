{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-desk",
  "version": "0.1.0",
  "identifier": "com.karthikbhattar.open-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "open-desk",
        "width": 220,
        "height": 110,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": true,
        "focusable": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../stt/realtime_stt_bridge.py": "stt/realtime_stt_bridge.py",
      "../stt/computer_agent.py": "stt/computer_agent.py",
      "../stt/requirements.txt": "stt/requirements.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
